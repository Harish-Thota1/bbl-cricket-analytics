{
  "name": "BBL Scouting Dark",
  "dataColors": [
    "#4A9EE8",
    "#3B7BB8",
    "#2C5B8A",
    "#1E3D5C",
    "#2DD4A0",
    "#FF6B6B",
    "#93A5B8",
    "#5D7591"
  ],
  "good": "#2DD4A0",
