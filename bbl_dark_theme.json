        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#93A5B8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#16293F"
              }
            },
            "fontSize": 10,
            "bold": false,
            "outline": "BottomOnly"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8EDF3"
              }
            },
            "backColor": {
              "solid": {
                "color": "#16293F"
              }
            },
            "fontSize": 11
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8EDF3"
              }
            },
            "backColor": {
              "solid": {
                "color": "#16293F"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E8EDF3"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#16293F"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "show": false
          }
